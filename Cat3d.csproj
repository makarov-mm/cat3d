<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- OpenGL is called through unmanaged function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The shaders are built into the executable and read with GetManifestResourceStream("cat.vert"). -->
    <None Remove="shaders\**" />
    <EmbeddedResource Include="shaders\**" LogicalName="%(Filename)%(Extension)" />
    <!-- The model and its textures are copied next to it. -->
    <None Update="objects\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
